# Supply-chain hardening for this project's own dependencies.
# Never run lifecycle scripts (preinstall/install/postinstall) of dependencies – the #1 malware execution vector.
# Nothing in this project needs them: esbuild ships its binary as an optional dependency, and vsce works without keytar's native build.
ignore-scripts=true
# Record exact versions; upgrades are deliberate (see SECURITY.md → Dependency policy).
save-exact=true
engine-strict=true
fund=false
audit-level=moderate
